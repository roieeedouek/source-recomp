+PUBLIC int wsi_videoout_refresh_millihertz(void);
+
+/* The output's refresh once VideoOut is open: 119880 in the high-frame-rate
+ * mode, 59940 otherwise; 0 before it is open. A title picks its flip rate
+ * from it (a 60 frames a second cap is rate 1 at 119.88 Hz, rate 0 at 59.94). */
+PUBLIC int
+wsi_videoout_refresh_millihertz(void)
+{
+   call_once(&videoout_once, videoout_output_init_once);
+   mtx_lock(&videoout_output.lock);
+   const int result = videoout_output.handle < 0 || !videoout_output.opened
+                         ? 0
+                         : videoout_output.high_frame_rate ? VIDEOOUT_HIGH_REFRESH_MILLIHERTZ : VIDEOOUT_REFRESH_MILLIHERTZ;
+   mtx_unlock(&videoout_output.lock);
+   return result;
+}
 
